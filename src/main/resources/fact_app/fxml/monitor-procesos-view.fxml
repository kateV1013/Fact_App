<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.edu.uam.fact_app.controller.MonitorProcesosController"
      alignment="TOP_CENTER"
      spacing="18.0"
      prefWidth="620.0"
      prefHeight="410.0"
      style="-fx-background-color: linear-gradient(to bottom, #f2e4c8, #dfc99f); -fx-font-family: 'Georgia', 'Cambria', 'Times New Roman', serif;">

    <padding>
        <Insets top="24.0" right="28.0" bottom="24.0" left="28.0" />
    </padding>

    <Label text="Monitor de procesamiento empresarial"
           style="-fx-font-size: 23px; -fx-font-weight: bold; -fx-text-fill: #3d271c;" />

    <VBox spacing="12.0"
          style="-fx-background-color: #fffaf0; -fx-border-color: #b88a50; -fx-border-radius: 7px; -fx-background-radius: 7px; -fx-padding: 16px;">
        <children>
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <children>
                    <Label text="Clientes"
                           prefWidth="110.0"
                           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #4f6f47;" />
                    <Label fx:id="lblEstadoClientes"
                           text="Clientes en espera"
                           HBox.hgrow="ALWAYS"
                           style="-fx-text-fill: #4a2f22;" />
                    <Label fx:id="lblPorcentajeClientes"
                           text="0%"
                           prefWidth="48.0"
                           style="-fx-font-weight: bold; -fx-text-fill: #4f6f47;" />
                </children>
            </HBox>
            <ProgressBar fx:id="barraClientes"
                         progress="0.0"
                         prefWidth="540.0" />
            <HBox alignment="CENTER_RIGHT" spacing="10.0">
                <children>
                    <Button fx:id="btnIniciarClientes"
                            text="Iniciar clientes"
                            onAction="#iniciarClientes"
                            style="-fx-background-color: #4f6f47; -fx-text-fill: #fff8e8; -fx-font-weight: bold;" />
                    <Button fx:id="btnDetenerClientes"
                            text="Detener clientes"
                            onAction="#detenerClientes"
                            disable="true"
                            style="-fx-background-color: #8a3e33; -fx-text-fill: #fff8e8; -fx-font-weight: bold;" />
                </children>
            </HBox>
        </children>
    </VBox>

    <VBox spacing="12.0"
          style="-fx-background-color: #fffaf0; -fx-border-color: #b88a50; -fx-border-radius: 7px; -fx-background-radius: 7px; -fx-padding: 16px;">
        <children>
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <children>
                    <Label text="Productos"
                           prefWidth="110.0"
                           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #386a79;" />
                    <Label fx:id="lblEstadoProductos"
                           text="Productos en espera"
                           HBox.hgrow="ALWAYS"
                           style="-fx-text-fill: #4a2f22;" />
                    <Label fx:id="lblPorcentajeProductos"
                           text="0%"
                           prefWidth="48.0"
                           style="-fx-font-weight: bold; -fx-text-fill: #386a79;" />
                </children>
            </HBox>
            <ProgressBar fx:id="barraProductos"
                         progress="0.0"
                         prefWidth="540.0" />
            <HBox alignment="CENTER_RIGHT" spacing="10.0">
                <children>
                    <Button fx:id="btnIniciarProductos"
                            text="Iniciar productos"
                            onAction="#iniciarProductos"
                            style="-fx-background-color: #386a79; -fx-text-fill: #fff8e8; -fx-font-weight: bold;" />
                    <Button fx:id="btnDetenerProductos"
                            text="Detener productos"
                            onAction="#detenerProductos"
                            disable="true"
                            style="-fx-background-color: #8a3e33; -fx-text-fill: #fff8e8; -fx-font-weight: bold;" />
                </children>
            </HBox>
        </children>
    </VBox>

    <HBox alignment="CENTER" spacing="10.0">
        <children>
            <Button fx:id="btnReiniciar"
                    text="Reiniciar procesos"
                    onAction="#reiniciarProcesos"
                    style="-fx-background-color: #6d4f6f; -fx-text-fill: #fff8e8; -fx-font-weight: bold;" />
        </children>
    </HBox>
</VBox>
