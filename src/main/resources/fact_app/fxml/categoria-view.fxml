<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="420.0" prefWidth="640.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.edu.uam.fact_app.controller.CategoriaController">
    <children>
        <VBox spacing="14.0" AnchorPane.bottomAnchor="16.0" AnchorPane.leftAnchor="16.0"
              AnchorPane.rightAnchor="16.0" AnchorPane.topAnchor="16.0">
            <children>
                <Label text="Gestion de Categorias" style="-fx-font-size: 20px; -fx-font-weight: bold;" />

                <GridPane hgap="10.0" vgap="10.0">
                    <padding>
                        <Insets bottom="4.0" left="0.0" right="0.0" top="4.0" />
                    </padding>
                    <children>
                        <Label text="ID:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <TextField fx:id="txtId" promptText="ID" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                        <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <TextField fx:id="txtNombre" promptText="Nombre de la categoria"
                                   GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <CheckBox fx:id="chkActiva" selected="true" text="Activa"
                                  GridPane.columnIndex="1" GridPane.rowIndex="2" />
                    </children>
                </GridPane>

                <HBox spacing="8.0">
                    <children>
                        <Button fx:id="btnNuevo" text="Nuevo" onAction="#nuevo" />
                        <Button fx:id="btnGuardar" text="Guardar" onAction="#guardar" />
                        <Button fx:id="btnActualizar" text="Actualizar" onAction="#actualizar" />
                        <Button fx:id="btnEliminar" text="Eliminar" onAction="#eliminar" />
                    </children>
                </HBox>

                <TableView fx:id="tblCategorias" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="90.0" text="ID" />
                        <TableColumn fx:id="colNombre" prefWidth="360.0" text="Nombre" />
                        <TableColumn fx:id="colActiva" prefWidth="150.0" text="Activa" />
                    </columns>
                </TableView>
            </children>
        </VBox>
    </children>
</AnchorPane>
